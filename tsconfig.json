{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    // "moduleResolution":"node",
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*"
, "src/services"  ],
  "exclude": [
    "node_modules"
  ]
}
