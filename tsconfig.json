{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",

    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/*/",
    "src/services",
    "src/types/express.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}